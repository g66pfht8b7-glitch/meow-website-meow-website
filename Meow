
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MEOW — Creative Studio</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  min-height: 100vh;
  background: #070707;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  font-family: Arial, Helvetica, sans-serif;
  color: white;
}

/* Ánh sáng nền */
.ambient {
  position: absolute;
  width: 360px;
  height: 360px;
  background: #ed193b;
  filter: blur(150px);
  opacity: .09;
  border-radius: 50%;
  animation: ambient 6s ease-in-out infinite alternate;
}

.logo-wrap {
  position: relative;
  text-align: center;
  z-index: 2;
}

.logo {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3px;
  animation: float 4s ease-in-out 2s infinite;
}

.letter {
  color: white;
  font-size: clamp(65px, 15vw, 130px);
  font-weight: 900;
  letter-spacing: -8px;
  opacity: 0;
  transform: translateY(35px) rotate(-12deg);
  animation: appear .7s cubic-bezier(.2,.8,.2,1) forwards;
  text-shadow: 0 5px 30px rgba(255,255,255,.08);
}

.letter:nth-child(1) { animation-delay: .1s; }
.letter:nth-child(2) {
  color: #ed193b;
  animation-delay: .25s;
}
.letter:nth-child(3) { animation-delay: .4s; }
.letter:nth-child(4) { animation-delay: .55s; }

/* Vệt sáng */
.light {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    110deg,
    transparent 35%,
    rgba(255,255,255,.45) 50%,
    transparent 65%
  );
  transform: translateX(-120%);
  animation: sweep 1.2s ease 1.5s forwards;
  pointer-events: none;
}

/* Gạch chân */
.underline {
  height: 3px;
  width: 0;
  margin: 18px auto 0;
  background: #ed193b;
  border-radius: 10px;
  box-shadow: 0 0 15px rgba(237,25,59,.6);
  animation: draw .8s ease 1.1s forwards;
}

/* Dòng phụ */
.tagline {
  margin-top: 19px;
  font-size: 10px;
  letter-spacing: 5px;
  color: #777;
  opacity: 0;
  transform: translateY(8px);
  animation: subtitle .8s ease 1.5s forwards;
}

/* Hạt sáng */
.particle {
  position: absolute;
  width: 3px;
  height: 3px;
  background: white;
  border-radius: 50%;
  opacity: 0;
  animation: particle 4s ease-in-out infinite;
}

.p1 { top: -45px; left: 5%; animation-delay: 1s; }
.p2 { bottom: -35px; right: 10%; animation-delay: 2s; }
.p3 { top: 20px; right: -50px; animation-delay: 2.5s; }

@keyframes appear {
  to {
    opacity: 1;
    transform: translateY(0) rotate(0);
  }
}

@keyframes draw {
  to { width: 100%; }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-5px); }
}

@keyframes sweep {
  to { transform: translateX(120%); }
}

@keyframes subtitle {
  to { opacity: 1; transform: translateY(0); }
}

@keyframes ambient {
  from { transform: scale(.85); opacity: .06; }
  to { transform: scale(1.2); opacity: .12; }
}

@keyframes particle {
  0%, 100% { opacity: 0; transform: translateY(8px); }
  50% { opacity: .7; transform: translateY(-8px); }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
}
</style>
</head>

<body>

<div class="ambient"></div>

<div class="logo-wrap">

  <div class="logo">
    <span class="letter">M</span>
    <span class="letter">E</span>
    <span class="letter">O</span>
    <span class="letter">W</span>
    <div class="light"></div>
  </div>

  <div class="underline"></div>

  <div class="tagline">
    CREATIVE • MEDIA • IDEAS
  </div>

  <div class="particle p1"></div>
  <div class="particle p2"></div>
  <div class="particle p3"></div>

</div>

</body>
</html>
